# ── 服务 ─────────────────────────────────────────────
PORT=8090
HOST=0.0.0.0
# 放在反向代理后面时设为 1，让 cookie 走 secure
TRUST_PROXY=0

# ── MySQL（先建好库并授权一个用户，表结构会自动创建）─
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=babybook
DB_PASSWORD=changeme
DB_NAME=babybook

# ── 首次启动自动创建的管理员 ─────────────────────────
# 仅在 users 表为空时生效；登录后可在「设置」里改密码
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# ── 会话签名密钥（留空则自动生成并存入数据库）────────
SESSION_SECRET=
